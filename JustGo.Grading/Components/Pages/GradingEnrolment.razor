@page "/grading/enrol"
@page "/grading/enrol/{RouteEventId:guid}"
@using JustGo.Grading.Enrolment
@using JustGo.Grading.Models
@using JustGo.Grading.Paging
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ProtectedLocalStorage BrowserStorage
@inject ILogger<GradingEnrolment> Logger

<PageTitle>Enrol Members - ITKD</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudText Typo="Typo.h4" Class="mb-2">Enrol Members</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Book club members onto a grading event in JustGo.
    </MudText>
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
        Intended for club admins.
    </MudAlert>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">1. Choose a grading</MudText>
        <div class="enrolment-picker">
            <MudSelect T="Guid" Value="_selectedEventId" ValueChanged="SelectEventAsync" Label="Event"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_loadingEvents || _enrolling)"
                       Placeholder="@EnrolmentGuidance.EventPlaceholder(_loadingEvents, VisibleEvents.Count)"
                       ToStringFunc="@(id => EnrolmentGuidance.DescribeSelectedEvent(id, _eventLabels))"
                       AdornmentIcon="@Icons.Material.Filled.EmojiEvents" Adornment="Adornment.Start"
                       AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                @foreach (var evt in VisibleEvents)
                {
                    <MudSelectItem T="Guid" Value="@evt.Id">@EnrolmentGuidance.FormatEventLabel(evt.Name, evt.Date)</MudSelectItem>
                }
            </MudSelect>
        </div>
        @if (_loadingEvents || _loadingEvent)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Tertiary" Class="mt-3" />
        }
    </MudPaper>

    @if (_selectedEventId == Guid.Empty)
    {
        <MudPaper Class="pa-4 mb-4 enrolment-step-locked" Elevation="0">
            <MudText Typo="Typo.h6">2. Choose your club</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Choose a grading above to unlock this step.</MudText>
        </MudPaper>
    }

    @if (_selectedEventId != Guid.Empty)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">2. Choose your club</MudText>
            <div class="enrolment-picker">
                <MudAutocomplete T="ClubOption" Value="_selectedClub" ValueChanged="SelectClubAsync"
                                 SearchFunc="SearchClubsAsync" ToStringFunc="@(club => club?.DisplayName)"
                                 Label="Club" Placeholder="Start typing a club name..."
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ResetValueOnEmptyText="true"
                                 MaxItems="null" Disabled="@(_loadingClubs || _loadingEvent || _enrolling)"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Groups" />
            </div>

            @if (_rosterCache is null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">
                    Choose your club to list its members. More members load as you scroll.
                </MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mt-4 mb-1">
                    <MudText Typo="Typo.subtitle2">@RosterHeading</MudText>
                    @if (_rosterCache.TotalCount is { } total)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@total member(s)</MudText>
                    }
                </div>

                <div class="enrolment-roster" tabindex="-1">
                    @if (IsWaitingForFirstRosterPage)
                    {
                        <div aria-busy="true" aria-label="Loading club members">
                            @for (var i = 0; i < RosterSkeletonCount; i++)
                            {
                                @MemberCardSkeleton
                            }
                        </div>
                    }
                    <Virtualize @key="_rosterCache" TItem="EnrolmentRow" ItemsProvider="LoadRosterAsync"
                                ItemSize="84" OverscanCount="2" Context="row">
                        <ItemContent>
                            <div @key="row.MemberId" class="@MemberCardClass(row)"
                                 role="checkbox" aria-checked="@(row.IsSelected ? "true" : "false")"
                                 aria-disabled="@(!row.CanSelect || _enrolling ? "true" : "false")"
                                 tabindex="@(row.CanSelect ? 0 : -1)"
                                 @onclick="() => ToggleSelected(row, !row.IsSelected)"
                                 @onkeydown="args => OnMemberCardKeyDown(row, args)">
                                <div class="member-card-avatar" aria-hidden="true">
                                    @if (row.IsSelected)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                    }
                                    else
                                    {
                                        @MemberCardText.Initials(row.FirstName, row.LastName)
                                    }
                                </div>
                                <div class="member-card-body">
                                    <div class="member-card-name">@MemberCardText.FullName(row.FirstName, row.LastName)</div>
                                    <div class="member-card-meta">
                                        <span>#@row.MemberNumber</span>
                                        <span aria-hidden="true">·</span>
                                        @if (MemberCardText.GradeProgression(row.CurrentGrade, row.NextGrade) is { } grades)
                                        {
                                            <span>@grades</span>
                                        }
                                        else
                                        {
                                            <MudSkeleton Width="8rem" />
                                        }
                                    </div>
                                </div>
                                @if (row.IsSelected)
                                {
                                    <div class="member-card-ticket" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                        <MudSelect T="Guid" @bind-Value="row.TicketId" Dense="true" Margin="Margin.Dense"
                                                   Label="Grade ticket" Variant="Variant.Outlined" Disabled="_enrolling">
                                            <MudSelectItem T="Guid" Value="Guid.Empty">Auto (next grade)</MudSelectItem>
                                            @foreach (var ticket in _tickets)
                                            {
                                                <MudSelectItem T="Guid" Value="@ticket.TicketId">@(ticket.GradeName ?? ticket.TicketName)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                }
                                <div class="member-card-status">
                                    @switch (row.Status)
                                    {
                                        case RowStatus.AlreadyBooked:
                                            <MudChip T="string" Color="Color.Info" Size="Size.Small">Already booked</MudChip>
                                            break;
                                        case RowStatus.Enrolled:
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Booked @row.BookedGrade</MudChip>
                                            break;
                                        case RowStatus.Failed:
                                            <MudTooltip Text="@row.Error">
                                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                                            </MudTooltip>
                                            break;
                                        default:
                                            <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">Not booked</MudChip>
                                            break;
                                    }
                                </div>
                            </div>
                        </ItemContent>
                        <Placeholder>
                            @MemberCardSkeleton
                        </Placeholder>
                        <EmptyContent>
                            @switch (EnrolmentGuidance.DescribeEmptyRoster(_rosterCache?.TotalCount, _rosterError))
                            {
                                case EmptyRosterState.Loading:
                                    break;
                                case EmptyRosterState.Failed:
                                    <MudAlert Severity="Severity.Error" Class="ma-2">@_rosterError</MudAlert>
                                    break;
                                default:
                                    <div class="enrolment-roster-empty">
                                        <MudIcon Icon="@Icons.Material.Outlined.GroupOff" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.body1">@EnrolmentGuidance.NoMembersMessage(_selectedClub?.Name)</MudText>
                                    </div>
                                    break;
                            }
                        </EmptyContent>
                    </Virtualize>
                </div>
            }

            <div class="d-flex align-center justify-end gap-2 mt-4">
                @if (_selectedRows.Count > 0)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearSelection" Disabled="_enrolling">
                        Clear selection
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EnrolSelectedAsync"
                           Disabled="@(_selectedRows.Count == 0 || _enrolling || _loadingEvent)"
                           StartIcon="@Icons.Material.Filled.PersonAdd">
                    @if (_enrolling)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @EnrolmentGuidance.BookButtonLabel(_selectedRows.Count)
                </MudButton>
            </div>
        </MudPaper>
    }
</MudContainer>

@code {
    private const int RosterPageSize = 10;
    private const string RememberedClubKey = "grading.enrol.clubId";

    [Parameter] public Guid? RouteEventId { get; set; }

    private bool _loadingEvents;
    private bool _loadingEvent;
    private bool _loadingClubs;
    private bool _enrolling;
    private bool _disposed;
    private string? _rosterError;
    private Guid _selectedEventId;
    private ClubOption? _selectedClub;
    private List<GradingEventOption> _allEvents = [];
    private Dictionary<Guid, string> _eventLabels = [];

    private IReadOnlyList<GradingEventOption> VisibleEvents =>
        GradingEventFilter.SelectVisible(_allEvents, includePast: true, DateTime.Today, _selectedEventId);

    private List<ClubOption> _clubs = [];
    private List<EventTicketApiDto> _tickets = [];
    private HashSet<Guid> _bookedMemberIds = [];
    private readonly Dictionary<Guid, EnrolmentRow> _selectedRows = [];
    private Task _clubsLoad = Task.CompletedTask;
    private PagedItemCache<EnrolmentRow>? _rosterCache;

    private HttpClient Api => HttpClientFactory.CreateClient("JustGoApi");

    private string RosterHeading => $"{_selectedClub?.Name} members";
    private const int RosterSkeletonCount = 6;

    // Virtualize renders nothing while its first fetch is in flight, so the page draws the skeleton itself.
    private bool IsWaitingForFirstRosterPage =>
        _rosterCache is not null
        && EnrolmentGuidance.DescribeEmptyRoster(_rosterCache.TotalCount, _rosterError) == EmptyRosterState.Loading;

    private static readonly RenderFragment MemberCardSkeleton =
        @<div class="member-card member-card--skeleton" aria-hidden="true">
            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" Animation="Animation.Wave" />
            <div class="member-card-body">
                <MudSkeleton Width="45%" Height="1.1rem" Animation="Animation.Wave" />
                <MudSkeleton Width="30%" Height="0.9rem" Animation="Animation.Wave" />
            </div>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="84px" Height="24px" Animation="Animation.Wave" Class="member-card-skeleton-chip" />
        </div>;

    private IEnumerable<EnrolmentRow> KnownRows =>
        (_rosterCache?.LoadedItems ?? Enumerable.Empty<EnrolmentRow>()).Concat(_selectedRows.Values).Distinct();

    protected override async Task OnInitializedAsync()
    {
        // Clubs come from a slow JustGo call, so the grading list must not wait for them.
        _clubsLoad = LoadClubsInBackgroundAsync();
        await LoadEventsAsync();

        if (RouteEventId is not { } eventId)
        {
            if (EnrolmentGuidance.SoleBookableEventId(VisibleEvents) is { } onlyEventId)
            {
                await SelectEventAsync(onlyEventId);
            }

            return;
        }

        if (_allEvents.Any(evt => evt.Id == eventId))
        {
            await SelectEventAsync(eventId);
        }
        else if (!_loadingEvents && _allEvents.Count > 0)
        {
            Snackbar.Add("That grading isn't accepting bookings, so members can't be booked onto it here.", Severity.Warning);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreRememberedClubAsync();
        }
    }

    public void Dispose() => _disposed = true;

    private async Task LoadClubsInBackgroundAsync()
    {
        await LoadClubsAsync();
        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadEventsAsync()
    {
        _loadingEvents = true;
        try
        {
            var response = await Api.GetAsync("grading/events/accepting-bookings");
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Failed to load grading events (HTTP {(int)response.StatusCode}).", Severity.Error);
                return;
            }

            var json = await response.Content.ReadFromJsonAsync<JsonElement>();
            _allEvents = ParseEventOptions(json);
            _eventLabels = _allEvents.ToDictionary(evt => evt.Id, evt => EnrolmentGuidance.FormatEventLabel(evt.Name, evt.Date));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load grading events");
            Snackbar.Add($"Failed to load grading events: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingEvents = false;
        }
    }

    private async Task LoadClubsAsync()
    {
        _loadingClubs = true;
        try
        {
            _clubs = await Api.GetFromJsonAsync<List<ClubOption>>("grading/clubs") ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load clubs");
            Snackbar.Add("Couldn't load the club list from JustGo. Start typing in Club to try again.", Severity.Error);
        }
        finally
        {
            _loadingClubs = false;
        }
    }

    private async Task RestoreRememberedClubAsync()
    {
        try
        {
            await _clubsLoad;
            var remembered = await BrowserStorage.GetAsync<Guid>(RememberedClubKey);
            var club = remembered.Success ? _clubs.FirstOrDefault(c => c.Id == remembered.Value) : null;
            if (club is not null && _selectedClub is null)
            {
                _selectedClub = club;
                ResetRoster();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // A missing or unreadable remembered club should never block the page.
            Logger.LogWarning(ex, "Could not restore the remembered club");
        }
    }

    private async Task RememberClubAsync(ClubOption? club)
    {
        try
        {
            if (club is null)
            {
                await BrowserStorage.DeleteAsync(RememberedClubKey);
            }
            else
            {
                await BrowserStorage.SetAsync(RememberedClubKey, club.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not remember the selected club");
        }
    }

    private static List<GradingEventOption> ParseEventOptions(JsonElement json)
    {
        if (!json.TryGetProperty("data", out var data) || data.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        return data.EnumerateArray()
            .Select(item => new GradingEventOption(
                Id: item.TryGetProperty("id", out var id) && id.TryGetGuid(out var guid) ? guid : Guid.Empty,
                Name: item.TryGetProperty("eventName", out var name) ? name.GetString() ?? string.Empty : string.Empty,
                Date: item.TryGetProperty("startDate", out var date) && date.TryGetDateTime(out var parsed) ? parsed : null,
                Status: item.TryGetProperty("status", out var status) ? status.GetString() : null))
            .Where(evt => evt.Id != Guid.Empty)
            .ToList();
    }

    private async Task SelectEventAsync(Guid eventId)
    {
        _selectedEventId = eventId;
        if (EnrolmentGuidance.NeedsNavigationToEvent(new Uri(Navigation.Uri), eventId))
        {
            Navigation.NavigateTo(EnrolmentGuidance.EventPath(eventId), replace: true);
        }
        await LoadEventBookingsAsync();
        ClearSelection();

        ResetRoster();
    }

    private async Task LoadEventBookingsAsync()
    {
        _loadingEvent = true;
        StateHasChanged();
        try
        {
            var ticketsTask = Api.GetFromJsonAsync<List<EventTicketApiDto>>($"grading/events/{_selectedEventId}/tickets");
            var candidatesTask = Api.GetFromJsonAsync<List<BookedCandidateApiDto>>($"grading/events/{_selectedEventId}/candidates");
            await Task.WhenAll(ticketsTask, candidatesTask);

            _tickets = ticketsTask.Result ?? [];
            _bookedMemberIds = (candidatesTask.Result ?? []).Select(candidate => candidate.MemberId).ToHashSet();
            MarkAlreadyBookedRows();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load bookings for event {EventId}", _selectedEventId);
            Snackbar.Add($"Failed to load event bookings: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingEvent = false;
        }
    }

    private void MarkAlreadyBookedRows()
    {
        foreach (var row in KnownRows.Where(row => row.Status is RowStatus.NotBooked && _bookedMemberIds.Contains(row.MemberId)))
        {
            row.Status = RowStatus.AlreadyBooked;
            SetSelected(row, false);
        }
    }

    private async Task<IEnumerable<ClubOption>> SearchClubsAsync(string? text, CancellationToken ct)
    {
        if (_clubs.Count == 0 && !_loadingClubs)
        {
            await LoadClubsAsync();
        }

        return string.IsNullOrWhiteSpace(text)
            ? _clubs
            : _clubs.Where(club => club.DisplayName.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private async Task SelectClubAsync(ClubOption? club)
    {
        if (club?.Id == _selectedClub?.Id)
        {
            return;
        }

        _selectedClub = club;
        ResetRoster();
        await RememberClubAsync(club);
    }

    // A new cache instance re-keys the Virtualize component, so it starts again from the top.
    private void ResetRoster()
    {
        _rosterError = null;
        _rosterCache = _selectedClub is null
            ? null
            : CreateRosterCache(_selectedClub.Id);
    }

    private PagedItemCache<EnrolmentRow> CreateRosterCache(Guid clubId)
    {
        var cache = new PagedItemCache<EnrolmentRow>(
            RosterPageSize,
            (pageNumber, ct) => FetchRosterPageAsync(clubId, pageNumber, ct));
        cache.PageLoaded += rows => _ = LoadCurrentGradesAsync(rows);
        return cache;
    }

    private async Task<PageResult<EnrolmentRow>> FetchRosterPageAsync(Guid clubId, int pageNumber, CancellationToken ct)
    {
        var query = $"page={pageNumber}&pageSize={RosterPageSize}&clubId={clubId}";
        var result = await Api.GetFromJsonAsync<MemberSearchApiResponse>($"grading/members?{query}", ct)
            ?? new MemberSearchApiResponse();
        var rows = result.Members.Select(CreateRow).ToList();
        return new PageResult<EnrolmentRow>(rows, result.TotalCount);
    }

    private async ValueTask<ItemsProviderResult<EnrolmentRow>> LoadRosterAsync(ItemsProviderRequest request)
    {
        var cache = _rosterCache;
        if (cache is null)
        {
            return new ItemsProviderResult<EnrolmentRow>([], 0);
        }

        var wasWaitingForFirstPage = IsWaitingForFirstRosterPage;
        try
        {
            var page = await cache.GetRangeAsync(request.StartIndex, request.Count, request.CancellationToken);
            _rosterError = null;
            return new ItemsProviderResult<EnrolmentRow>(page.Items, page.TotalCount);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load members page starting at {StartIndex}", request.StartIndex);
            _rosterError = $"Failed to load members: {ex.Message}";
            Snackbar.Add(_rosterError, Severity.Error);
            return new ItemsProviderResult<EnrolmentRow>([], cache.TotalCount ?? 0);
        }
        finally
        {
            if (wasWaitingForFirstPage && ReferenceEquals(cache, _rosterCache))
            {
                StateHasChanged();
            }
        }
    }

    // Reusing a selected member's row keeps its tick and ticket choice when the roster reloads.
    private EnrolmentRow CreateRow(MemberSearchApiDto member) =>
        _selectedRows.TryGetValue(member.JustGoMemberId, out var selected)
            ? selected
            : new EnrolmentRow
            {
                MemberId = member.JustGoMemberId,
                MemberNumber = member.MemberId,
                FirstName = member.FirstName,
                LastName = member.LastName,
                Status = _bookedMemberIds.Contains(member.JustGoMemberId) ? RowStatus.AlreadyBooked : RowStatus.NotBooked,
            };

    private async Task LoadCurrentGradesAsync(IReadOnlyList<EnrolmentRow> rows)
    {
        var pending = rows.Where(row => row.CurrentGrade is null && row.MemberId != Guid.Empty).ToList();
        if (pending.Count == 0)
        {
            return;
        }

        try
        {
            var memberIds = pending.Select(row => row.MemberId).Distinct().ToList();
            var response = await Api.PostAsJsonAsync("grading/members/details", new { MemberIds = memberIds });
            var details = response.IsSuccessStatusCode
                ? await response.Content.ReadFromJsonAsync<List<MemberGradeApiDto>>() ?? []
                : [];
            var detailById = details.ToDictionary(detail => detail.MemberId);

            foreach (var row in pending)
            {
                var found = detailById.TryGetValue(row.MemberId, out var detail);
                row.CurrentGrade = found ? detail!.CurrentGrade : MemberCardText.UnknownGrade;
                row.NextGrade = found ? detail!.NextGrade : null;
                if (found && row.TicketId == Guid.Empty)
                {
                    row.TicketId = FindTicketIdForGrade(detail!.NextGrade);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load current grades for member rows");
            foreach (var row in pending.Where(row => row.CurrentGrade is null))
            {
                row.CurrentGrade = MemberCardText.UnknownGrade;
            }
        }

        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private Guid FindTicketIdForGrade(string? gradeName) =>
        _tickets.FirstOrDefault(ticket => string.Equals(ticket.GradeName, gradeName, StringComparison.OrdinalIgnoreCase))?.TicketId
        ?? Guid.Empty;

    private void ToggleSelected(EnrolmentRow row, bool selected)
    {
        if (row.CanSelect && !_enrolling)
        {
            SetSelected(row, selected);
        }
    }

    private void OnMemberCardKeyDown(EnrolmentRow row, KeyboardEventArgs args)
    {
        if (args.Key is " " or "Enter" or "NumpadEnter")
        {
            ToggleSelected(row, !row.IsSelected);
        }
    }

    private string MemberCardClass(EnrolmentRow row) =>
        (row.IsSelected, row.CanSelect) switch
        {
            (true, _) => "member-card member-card--selected",
            (false, false) => "member-card member-card--locked",
            _ => "member-card",
        };

    private void SetSelected(EnrolmentRow row, bool selected)
    {
        row.IsSelected = selected;
        if (selected)
        {
            _selectedRows[row.MemberId] = row;
        }
        else
        {
            _selectedRows.Remove(row.MemberId);
        }
    }

    private void ClearSelection()
    {
        foreach (var row in _selectedRows.Values.ToList())
        {
            SetSelected(row, false);
        }
    }

    private async Task EnrolSelectedAsync()
    {
        var selected = _selectedRows.Values.Where(row => row.CanSelect).ToList();
        if (selected.Count == 0)
        {
            return;
        }

        _enrolling = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                Members = selected.Select(row => new
                {
                    MemberId = row.MemberId,
                    TicketId = row.TicketId == Guid.Empty ? (Guid?)null : row.TicketId,
                }),
            };

            var response = await Api.PostAsJsonAsync($"grading/events/{_selectedEventId}/enrolments", request);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Booking failed (HTTP {(int)response.StatusCode}). {body}", Severity.Error);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<EnrolmentApiResponse>()
                ?? throw new InvalidOperationException("The grading API returned an empty response.");
            ApplyEnrolmentResults(result);
            ShowEnrolmentSummary(result);
            await LoadEventBookingsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to enrol members onto event {EventId}", _selectedEventId);
            Snackbar.Add($"Booking failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _enrolling = false;
        }
    }

    private void ApplyEnrolmentResults(EnrolmentApiResponse result)
    {
        var rowsById = KnownRows.GroupBy(row => row.MemberId).ToDictionary(group => group.Key, group => group.ToList());
        foreach (var detail in result.Details)
        {
            if (!rowsById.TryGetValue(detail.MemberId, out var rows))
            {
                continue;
            }

            foreach (var row in rows)
            {
                row.Error = detail.Error;
                row.BookedGrade = detail.GradeName;
                row.Status = detail.Outcome switch
                {
                    "Enrolled" => RowStatus.Enrolled,
                    "AlreadyEnrolled" => RowStatus.AlreadyBooked,
                    _ => RowStatus.Failed,
                };
                SetSelected(row, row.Status is RowStatus.Failed && row.IsSelected);
            }
        }
    }

    private void ShowEnrolmentSummary(EnrolmentApiResponse result)
    {
        if (result.Enrolled > 0)
        {
            Snackbar.Add($"Booked {result.Enrolled} member(s) onto the grading.", Severity.Success);
        }

        if (result.AlreadyEnrolled > 0)
        {
            Snackbar.Add($"{result.AlreadyEnrolled} member(s) were already booked and were skipped.", Severity.Info);
        }

        if (result.Failed > 0)
        {
            Snackbar.Add($"{result.Failed} member(s) could not be booked. Failed rows stay selected so you can retry.", Severity.Error);
        }
    }

    private enum RowStatus
    {
        NotBooked,
        AlreadyBooked,
        Enrolled,
        Failed,
    }

    private sealed class EnrolmentRow
    {
        public Guid MemberId { get; init; }
        public string MemberNumber { get; init; } = string.Empty;
        public string FirstName { get; init; } = string.Empty;
        public string LastName { get; init; } = string.Empty;
        public string? CurrentGrade { get; set; }
        public string? NextGrade { get; set; }
        public Guid TicketId { get; set; }
        public bool IsSelected { get; set; }
        public RowStatus Status { get; set; }
        public string? BookedGrade { get; set; }
        public string? Error { get; set; }
        public bool CanSelect => Status is RowStatus.NotBooked or RowStatus.Failed;
    }

    private sealed class ClubOption
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Town { get; set; } = string.Empty;
        public string DisplayName => string.IsNullOrWhiteSpace(Town) ? Name : $"{Name} ({Town})";
    }


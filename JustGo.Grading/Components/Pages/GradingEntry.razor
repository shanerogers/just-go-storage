@page "/grading"
@page "/grading/{RouteEventId:guid}"
@using JustGo.Grading.Models
@using Humanizer
@using Microsoft.Extensions.Options
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ILogger<GradingEntry> Logger
@inject IOptions<GradingOptions> GradingOptionsAccessor

<PageTitle>Grading Entry - ITKD</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudText Typo="Typo.h4" Class="mb-4">Grading Entry</MudText>

    @if (!_eventLoaded)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">Event Lookup</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @ref="_eventSearchField" @bind-Value="_eventSearch" Label="Event Number or Name"
                                  Variant="Variant.Outlined" Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="e.g. EV102452"
                                  Immediate="true"
                                  OnKeyDown="OnEventSearchKeyDown" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" Class="d-flex align-end" Style="padding-bottom: 4px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SearchEvents" Disabled="_searching"
                               StartIcon="@Icons.Material.Filled.Search">
                        @if (_searching)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Search
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary"
                               OnClick="LoadAllEvents" Disabled="_searching"
                               StartIcon="@Icons.Material.Filled.ViewList"
                               Class="ml-2">
                        Show All
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_searching)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
            }

            @if (_searchResults.Count > 0)
            {
                <div class="mt-4" style="max-height: 400px; overflow-y: auto;">
                    @foreach (var evt in _searchResults)
                    {
                        <MudPaper @key="evt.Id" Class="pa-3 mb-2" Elevation="0" Outlined="true"
                                  Style="cursor: pointer;" @onclick="@(() => SelectEvent(evt))">
                            <MudText Typo="Typo.subtitle1"><b>@evt.Name</b></MudText>
                            <div class="d-flex align-center gap-3 mt-1 flex-wrap">
                                <MudText Typo="Typo.caption">@evt.Date?.ToString("dd MMM yyyy")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@evt.Club</MudText>
                            </div>
                        </MudPaper>
                    }
                </div>
            }
            else if (_searchCompleted)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">No events found.</MudAlert>
            }
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudText Typo="Typo.subtitle1"><b>@_selectedEvent!.Name</b></MudText>
                    <div class="d-flex align-center gap-3 mt-1">
                        <MudText Typo="Typo.caption">@_selectedEvent!.Date?.ToString("dd MMM yyyy")</MudText>
                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">@_selectedEvent!.Club</MudChip>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-center justify-end">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearEvent"
                               StartIcon="@Icons.Material.Filled.ArrowBack">
                        Change Event
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_loadingMembers)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            <MudText>Loading members...</MudText>
        }
        else
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" Class="d-flex justify-start align-center">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="OpenAddMembersDialog"
                                   Disabled="@_loadingMembers"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">
                            Add Members to Grading
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <div class="d-flex align-center justify-space-between gap-2 flex-wrap">
                    <MudText Typo="Typo.h6">
                        Grading Roster
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@_members.Count</MudChip>
                    </MudText>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                    Record each result after confirming the grade, outcome, and optional theory mark. Issued credentials remain visible but cannot be changed.
                </MudText>

                <div class="grading-record-list mt-4">
                    @foreach (var member in _members)
                    {
                        <MudPaper @key="member.JustGoMemberId" Class="grading-record-card pa-3" Elevation="0" Outlined="true">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4">
                                    <div class="d-flex align-center justify-space-between gap-2 flex-wrap">
                                        <div>
                                            <MudText Typo="Typo.subtitle1">@member.FirstName @member.LastName</MudText>
                                            <MudText Typo="Typo.caption">@member.MemberId</MudText>
                                        </div>
                                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">
                                            @(member.IsManuallyAdded ? "Added manually" : "Event booking")
                                        </MudChip>
                                    </div>
                                    @if (!member.LoadingGrade && member.LastGradingDate.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="@(member.IsWithin90Days ? Color.Warning : Color.Default)" Class="mt-1">
                                            Last graded: @member.LastGradingDate.Value.ToString("dd MMM yyyy")
                                        </MudText>
                                    }
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Grade</MudText>
                                    @if (member.LoadingGrade)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-center gap-1">
                                            <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">@member.CurrentGrade</MudChip>
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Primary" />
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                                @(member.IsDoubleGrading ? member.DoubleGrade ?? member.NextGrade : member.NextGrade)
                                            </MudChip>
                                        </div>
                                    }
                                    <MudCheckBox @bind-Value="member.IsDoubleGrading" Color="Color.Secondary"
                                                 Label="Double" Disabled="@(member.HasIssuedCredential || member.IsWithin90Days || member.IsSubmittingResult)" Dense="true" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Result</MudText>
                                    <div class="grading-record-controls">
                                        <MudSelect T="string" @bind-Value="member.Outcome" Label="Outcome"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   Disabled="@(member.HasIssuedCredential || member.IsSubmittingResult)" Required="true">
                                            @foreach (var outcome in OutcomeOptions)
                                            {
                                                <MudSelectItem T="string" Value="@outcome">@outcome</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudNumericField @bind-Value="member.TheoryMark" Label="Theory"
                                                         Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Disabled="@(member.HasIssuedCredential || member.IsSubmittingResult)" />
                                    </div>
                                </MudItem>
                                <MudItem xs="12" md="2" Class="d-flex flex-column align-stretch justify-center">
                                    @if (member.HasIssuedCredential)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Issued</MudChip>
                                    }
                                    else if (member.GradeLoadFailed)
                                    {
                                        <MudTooltip Text="@GetGradeLoadError(member)">
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">JustGo details unavailable</MudChip>
                                        </MudTooltip>
                                    }
                                    else if (member.IsSubmittingResult)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">Recording</MudChip>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(member.SubmissionError))
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">Ready</MudChip>
                                    }

                                    @if (!member.HasIssuedCredential)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                                                   Disabled="@(member.IsSubmittingResult || member.LoadingGrade || member.GradeLoadFailed)"
                                                   OnClick="@(() => RecordResultAsync(member))"
                                                   StartIcon="@Icons.Material.Filled.CheckCircle">
                                            @if (member.IsSubmittingResult)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                            }
                                            Record result
                                        </MudButton>
                                        @if (!string.IsNullOrWhiteSpace(member.SubmissionError))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@member.SubmissionError</MudText>
                                        }
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </div>
            </MudPaper>

        }
    }
</MudContainer>

@code {
    private MudTextField<string>? _eventSearchField;
    private string _eventSearch = string.Empty;
    private bool _searching;
    private bool _searchCompleted;
    private bool _eventLoaded;
    private bool _loadingMembers;
    private int _totalMemberCount;
    private EventResult? _selectedEvent;
    private List<EventResult> _searchResults = [];
    private List<GradingMember> _members = [];
    private List<EventTicketApiDto> _eventTickets = [];
    private List<EventCandidateApiDto> _eventCandidates = [];
    private static IReadOnlyList<string> OutcomeOptions { get; } = ["A", "P", "P-"];

    private HttpClient Api => HttpClientFactory.CreateClient("JustGoApi");

    [Parameter] public Guid? RouteEventId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await FetchEvents();

        if (RouteEventId is { } eventId && eventId != Guid.Empty)
        {
            var match = _searchResults.FirstOrDefault(e => e.Id == eventId);
            if (match is not null)
            {
                await SelectEvent(match);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _eventSearchField is not null && !_eventLoaded)
        {
            await _eventSearchField.FocusAsync();
        }
    }

    private async Task SearchEvents()
    {
        await FetchEvents(_eventSearch);
    }

    private async Task LoadAllEvents()
    {
        _eventSearch = string.Empty;
        await FetchEvents();
    }

    private async Task OnEventSearchKeyDown(KeyboardEventArgs args)
    {
        if (_searching) return;
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await SearchEvents();
        }
    }

    private async Task FetchEvents(string? name = null)
    {
        _searching = true;
        _searchCompleted = false;
        _searchResults.Clear();
        StateHasChanged();

        try
        {
            var baseUri = "grading/events?pageNumber=1&pageSize=200";
            var requestUri = string.IsNullOrWhiteSpace(name)
                ? baseUri
                : $"{baseUri}&search={Uri.EscapeDataString(name)}";

            var httpResponse = await Api.GetAsync(requestUri);
            if (!httpResponse.IsSuccessStatusCode)
            {
                await ShowApiErrorAsync(httpResponse, "Event search failed");
                return;
            }

            var response = await httpResponse.Content.ReadFromJsonAsync<JsonElement>();

            if (response.TryGetProperty("data", out var items))
            {
                foreach (var item in items.EnumerateArray())
                {
                    _searchResults.Add(new EventResult
                    {
                        Id = TryGetGuid(item, "id"),
                        Name = TryGetString(item, "eventName"),
                        Date = TryGetDateTime(item, "startDate"),
                        Club = TryGetString(item, "organizationName"),
                    });
                }
            }
        }
        catch (Exception ex)
        {
            ShowError("Event search failed", ex);
        }

        _searching = false;
        _searchCompleted = true;
    }

    private static Guid TryGetGuid(JsonElement element, string propertyName)
    {
        if (!element.TryGetProperty(propertyName, out var value) ||
            value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return Guid.Empty;
        }

        return value.ValueKind == JsonValueKind.String &&
               Guid.TryParse(value.GetString(), out var parsedGuid)
            ? parsedGuid
            : value.TryGetGuid(out parsedGuid)
                ? parsedGuid
                : Guid.Empty;
    }

    private static string TryGetString(JsonElement element, string propertyName)
    {
        if (!element.TryGetProperty(propertyName, out var value) ||
            value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return string.Empty;
        }

        return value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : value.ToString();
    }

    private static DateTime? TryGetDateTime(JsonElement element, string propertyName)
    {
        if (!element.TryGetProperty(propertyName, out var value) ||
            value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return null;
        }

        if (value.TryGetDateTime(out var parsedDate))
        {
            return parsedDate;
        }

        return value.ValueKind == JsonValueKind.String &&
               DateTime.TryParse(value.GetString(), out parsedDate)
            ? parsedDate
            : null;
    }

    private async Task SelectEvent(EventResult eventResult)
    {
        _selectedEvent = eventResult;
        _eventLoaded = true;
        _loadingMembers = true;
        Navigation.NavigateTo($"/grading/{eventResult.Id}", replace: true);
        StateHasChanged();

        try
        {
            await LoadEventFastDataAsync();
            RebuildMembersFromCandidates();
            _loadingMembers = false;
            StateHasChanged();

            // Fire per-member grade enrichment — each row loads independently
            _ = EnrichAllMemberGradesAsync();
        }
        catch (Exception ex)
        {
            ShowError("Failed to load event", ex);
            _loadingMembers = false;
            StateHasChanged();
        }
    }

    private void RebuildMembersFromCandidates()
    {
        var eventDate = _selectedEvent?.Date ?? DateTime.Today;
        _members = _eventCandidates
            .GroupBy(candidate => candidate.MemberId)
            .Select(candidates => candidates.First())
            .Select(c => new GradingMember
            {
                JustGoMemberId = c.MemberId,
                MemberId = c.MemberNumber,
                FirstName = c.FirstName,
                LastName = c.LastName,
                LastGradingDate = c.LastGradingDate is { } d ? d.ToDateTime(TimeOnly.MinValue) : null,
                CurrentGrade = c.CurrentGrade,
                NextGrade = c.NextGrade,
                DoubleGrade = c.DoubleGrade,
                GradingEventDate = eventDate,
                BookingId = c.BookingId,
                Grading = false,
                HasIssuedCredential = c.HasIssuedCredential,
            })
            .ToList();

        _totalMemberCount = _eventCandidates.Count;
    }

    private void ShowError(string prefix, Exception ex)
    {
        Logger.LogError(ex, "{Prefix}", prefix);
        Snackbar.Add($"{prefix}: {ex.Message}", Severity.Error);
    }

    private async Task ShowApiErrorAsync(HttpResponseMessage response, string prefix)
    {
        var body = await response.Content.ReadAsStringAsync();
        var message = $"{prefix}: {(int)response.StatusCode} {response.ReasonPhrase}";

        if (!string.IsNullOrWhiteSpace(body))
        {
            try
            {
                using var document = JsonDocument.Parse(body);
                var root = document.RootElement;

                if (root.TryGetProperty("detail", out var detail) &&
                    detail.ValueKind == JsonValueKind.String &&
                    !string.IsNullOrWhiteSpace(detail.GetString()))
                {
                    message = $"{prefix}: {detail.GetString()}";
                }
                else if (root.TryGetProperty("title", out var title) &&
                    title.ValueKind == JsonValueKind.String &&
                    !string.IsNullOrWhiteSpace(title.GetString()))
                {
                    message = $"{prefix}: {title.GetString()}";
                }
            }
            catch (JsonException)
            {
                message = $"{prefix}: {body}";
            }
        }

        Logger.LogError("API error — {Message} (HTTP {StatusCode})", message, (int)response.StatusCode);
        Snackbar.Add(message, Severity.Error);
    }

    private void ClearEvent()
    {
        _eventLoaded = false;
        _loadingMembers = false;
        _selectedEvent = null;
        _members.Clear();
        _searchResults.Clear();
        _searchCompleted = false;
        _totalMemberCount = 0;
        _eventTickets.Clear();
        _eventCandidates.Clear();
        Navigation.NavigateTo("/grading", replace: true);
    }

    private async Task OpenAddMembersDialog()
    {
        if (_selectedEvent is null) return;

        var existingMemberIds = _members.Select(m => m.JustGoMemberId).ToHashSet();

        var parameters = new DialogParameters
        {
            ["EventId"] = _selectedEvent.Id,
            ["ExistingMemberIds"] = existingMemberIds,
            ["EventTickets"] = _eventTickets,
            ["EventDate"] = _selectedEvent.Date ?? DateTime.Today,
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            BackgroundClass = "mud-dialog-backdrop",
        };

        var dialog = await DialogService.ShowAsync<AddMembersToGradingDialog>("Add Members to Grading", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<GradingMember> newMembers) return;

        foreach (var member in newMembers)
        {
            if (_members.Any(existing => existing.JustGoMemberId == member.JustGoMemberId))
            {
                continue;
            }

            member.IsManuallyAdded = true;
            _members.Add(member);
        }

        _totalMemberCount = _members.Count;
        _ = EnrichAllMemberGradesAsync();
    }

    private async Task LoadEventFastDataAsync()
    {
        if (_selectedEvent?.Id is null || _selectedEvent.Id == Guid.Empty)
        {
            _eventTickets.Clear();
            _eventCandidates.Clear();
            return;
        }

        var eventId = _selectedEvent.Id;

        // Parallel fast calls — tickets + candidates
        var ticketsTask = Api.GetAsync($"grading/events/{eventId}/tickets");
        var candidatesTask = Api.GetAsync($"grading/events/{eventId}/candidates");
        await Task.WhenAll(ticketsTask, candidatesTask);

        var ticketsResponse = ticketsTask.Result;
        var candidatesResponse = candidatesTask.Result;

        if (!ticketsResponse.IsSuccessStatusCode)
        {
            await ShowApiErrorAsync(ticketsResponse, "Failed to load tickets");
        }
        else
        {
            _eventTickets = await ticketsResponse.Content
                .ReadFromJsonAsync<List<EventTicketApiDto>>() ?? [];
        }

        if (!candidatesResponse.IsSuccessStatusCode)
        {
            await ShowApiErrorAsync(candidatesResponse, "Failed to load candidates");
        }
        else
        {
            _eventCandidates = await candidatesResponse.Content
                .ReadFromJsonAsync<List<EventCandidateApiDto>>() ?? [];
        }
    }

    private async Task EnrichAllMemberGradesAsync()
    {
        using var semaphore = new SemaphoreSlim(GradingOptionsAccessor.Value.MaxConcurrentEnrichments);
        var tasks = _members
            .Where(m => m.JustGoMemberId != Guid.Empty)
            .Select(async member =>
            {
                await semaphore.WaitAsync();
                try { await EnrichMemberGradeAsync(member); }
                finally { semaphore.Release(); }
            });

        await Task.WhenAll(tasks);
    }

    private async Task EnrichMemberGradeAsync(GradingMember member)
    {
        try
        {
            var response = await Api.GetAsync($"grading/members/{member.JustGoMemberId}/details");

            if (!response.IsSuccessStatusCode)
            {
                member.GradeLoadFailed = true;
                member.GradeLoadError = $"JustGo returned HTTP {(int)response.StatusCode} while loading member details.";
                member.LoadingGrade = false;
                await InvokeAsync(() =>
                {
                    Snackbar.Add($"Failed to load grades for {member.FirstName} {member.LastName}", Severity.Warning);
                    StateHasChanged();
                });
                return;
            }

            var detail = await response.Content.ReadFromJsonAsync<MemberDetailApiResult>();

            if (detail is null)
            {
                member.GradeLoadFailed = true;
                member.GradeLoadError = "JustGo returned no member details.";
                member.LoadingGrade = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            member.CurrentGrade = detail.CurrentGrade;
            member.NextGrade = detail.NextGrade;
            member.DoubleGrade = detail.DoubleGrade;
            member.LastGradingDate = detail.LastGradingDate is { } d
                ? d.ToDateTime(TimeOnly.MinValue)
                : null;
            member.LoadingGrade = false;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Grade enrichment failed for member {MemberId}", member.JustGoMemberId);
            member.GradeLoadFailed = true;
            member.GradeLoadError = ex.Message;
            member.LoadingGrade = false;
            await InvokeAsync(() =>
            {
                Snackbar.Add($"Failed to load grades for {member.FirstName} {member.LastName}", Severity.Warning);
                StateHasChanged();
            });
        }
    }

    private async Task RecordResultAsync(GradingMember member)
    {
        if (_selectedEvent is null || !ValidateResultCapture(member))
        {
            return;
        }

        member.IsSubmittingResult = true;
        member.SubmissionError = null;
        StateHasChanged();

        try
        {
            var targetGrade = member.IsDoubleGrading ? member.DoubleGrade ?? member.NextGrade : member.NextGrade;
            var ticket = _eventTickets.FirstOrDefault(t =>
                string.Equals(t.GradeName, targetGrade, StringComparison.OrdinalIgnoreCase));
            var request = new
            {
                EventId = _selectedEvent.Id,
                EventName = _selectedEvent.Name,
                EventDate = _selectedEvent.Date?.ToString("yyyy-MM-dd") ?? DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd"),
                Results = new[]
                {
                    new
                    {
                        MemberId = member.JustGoMemberId,
                        BookingId = member.BookingId,
                        TicketId = ticket?.TicketId ?? Guid.Empty,
                        MemberNumber = member.MemberId,
                        FirstName = member.FirstName,
                        LastName = member.LastName,
                        GradeName = targetGrade,
                        Outcome = member.Outcome,
                        TheoryMark = member.TheoryMark,
                        IsDoubleGrading = member.IsDoubleGrading,
                    },
                },
            };

            var response = await Api.PostAsJsonAsync("grading/submit", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GradingSubmitApiResponse>()
                    ?? throw new InvalidOperationException("The grading API returned an empty response.");
                var detail = result.Details.SingleOrDefault();
                if (detail?.Success == true)
                {
                    member.HasIssuedCredential = true;
                    member.BookingId = detail.BookingId ?? member.BookingId;
                    Snackbar.Add($"Recorded result for {member.FirstName} {member.LastName}.", Severity.Success);
                }
                else
                {
                    member.SubmissionError = detail?.Error ?? "The grading API did not return a result for this candidate.";
                }
            }
            else
            {
                member.SubmissionError = $"Unable to record result (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to record grading result for member {MemberId}", member.JustGoMemberId);
            member.SubmissionError = ex.Message;
        }
        finally
        {
            member.IsSubmittingResult = false;
            StateHasChanged();
        }
    }

    private static string GetGradeLoadError(GradingMember member) =>
        string.IsNullOrWhiteSpace(member.GradeLoadError)
            ? "JustGo member details could not be loaded, so the grade cannot be calculated."
            : member.GradeLoadError;

    private bool ValidateResultCapture(GradingMember member)
    {
        if (OutcomeOptions.Contains(member.Outcome, StringComparer.Ordinal) &&
            (!member.TheoryMark.HasValue || member.TheoryMark.Value is >= 0 and <= 100))
        {
            return true;
        }

        Snackbar.Add(
            $"Enter an outcome of A, P, or P- and an optional theory mark from 0 to 100 for {member.FirstName} {member.LastName}.",
            Severity.Error);
        return false;
    }

    private sealed class EventStateApiResponse
    {
        public Guid EventId { get; set; }
        public List<EventTicketApiDto> Tickets { get; set; } = [];

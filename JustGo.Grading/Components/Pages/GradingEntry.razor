@page "/grading"
@using JustGo.Grading.Models
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Grading Entry - ITKD</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudText Typo="Typo.h4" GutterBottom="true">Grading Entry</MudText>

    @if (!_eventLoaded)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">Event Lookup</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_eventSearch" Label="Event Number or Name"
                                  Variant="Variant.Outlined" Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="e.g. EV102452"
                                  OnKeyDown="OnEventSearchKeyDown" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SearchEvents" Disabled="_searching"
                               StartIcon="@Icons.Material.Filled.Search">
                        @if (_searching)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Search
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary"
                               OnClick="LoadAllEvents" Disabled="_searching"
                               StartIcon="@Icons.Material.Filled.ViewList"
                               Class="ml-2">
                        Show All
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_searching)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
            }

            @if (_searchResults.Count > 0)
            {
                <MudTable Items="_searchResults" Hover="true" Striped="true" Class="mt-4"
                          T="EventResult" OnRowClick="@(args => SelectEvent(args.Item!))">
                    <HeaderContent>
                        <MudTh>Event Name</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh>Club</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Date?.ToString("dd MMM yyyy")</MudTd>
                        <MudTd>@context.Club</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (_searchCompleted)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">No events found.</MudAlert>
            }
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Event</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Grading Date</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Date?.ToString("dd MMM yyyy")</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Club</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Club</MudText>
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearEvent"
                       StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-2">
                Change Event
            </MudButton>
        </MudPaper>

        @if (_loadingMembers)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            <MudText>Loading members...</MudText>
        }
        else
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" Class="d-flex justify-start align-center">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="OpenAddMembersDialog"
                                   Disabled="@(_loadingMembers || _submitting || EventCredentialEligibleMembers.Count == 0)"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">
                            Add Members to Grading
                        </MudButton>
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Class="mt-2 d-block">
                    Eligible members for this event credential: @EventCredentialEligibleMembers.Count
                </MudText>
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.h6">
                            Members in Grading
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                @GradingMembers.Count() selected
                            </MudChip>
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex justify-end align-center">
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            Total Loaded: @_totalMemberCount
                        </MudText>
                    </MudItem>
                </MudGrid>

                <MudTable Items="GradingMembers" Hover="true" Striped="true" Dense="true" Class="mt-4"
                          T="GradingMember" FixedHeader="true" Height="500px">
                    <HeaderContent>
                        <MudTh>MID</MudTh>
                        <MudTh>First Name</MudTh>
                        <MudTh>Last Name</MudTh>
                        <MudTh>Last Grading</MudTh>
                        <MudTh>Current Grade</MudTh>
                        <MudTh>Next Grade</MudTh>
                        <MudTh>Double</MudTh>
                        <MudTh>Theory Mark</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.MemberId</MudTd>
                        <MudTd>@context.FirstName</MudTd>
                        <MudTd>@context.LastName</MudTd>
                        <MudTd>
                            <MudText Color="@(context.IsWithin90Days ? Color.Error : Color.Default)">
                                @context.LastGradingDate?.ToString("dd-MM-yyyy")
                                @if (context.IsWithin90Days)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small"
                                             Color="Color.Error" Title="Within 90 days of last grading" />
                                }
                            </MudText>
                        </MudTd>
                        <MudTd>@context.CurrentGrade</MudTd>
                        <MudTd>@context.NextGrade</MudTd>
                        <MudTd>
                            <MudCheckBox @bind-Value="context.IsDoubleGrading" Color="Color.Secondary"
                                         Disabled="context.IsWithin90Days" />
                        </MudTd>
                        <MudTd>
                            <MudNumericField @bind-Value="context.TheoryMark" Min="0" Max="100"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Style="max-width: 80px;" />
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Text" Color="Color.Error"
                                       OnClick="@(() => RemoveFromGrading(context))"
                                       StartIcon="@Icons.Material.Filled.RemoveCircleOutline">
                                Remove
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" Class="d-flex justify-end gap-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(!GradingMembers.Any() || _submitting)"
                               OnClick="SubmitGrading"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               Size="Size.Large">
                        @if (_submitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Issue Credentials
                    </MudButton>
                </MudItem>
            </MudGrid>
        }
    }
</MudContainer>

@code {
    private string _eventSearch = string.Empty;
    private string? _eventCredential;
    private bool _searching;
    private bool _searchCompleted;
    private bool _eventLoaded;
    private bool _loadingMembers;
    private bool _submitting;
    private int _totalMemberCount;
    private EventResult? _selectedEvent;
    private List<EventResult> _searchResults = [];
    private List<GradingMember> _members = [];

    private IEnumerable<GradingMember> GradingMembers => _members.Where(m => m.Grading);
    private List<GradingMember> EventCredentialEligibleMembers =>
        _members.Where(m => m.MatchesEventCredential).ToList();

    private HttpClient Api => HttpClientFactory.CreateClient("JustGoApi");

    protected override async Task OnInitializedAsync()
    {
        await FetchEvents();
    }

    private async Task SearchEvents()
    {
        await FetchEvents(_eventSearch);
    }

    private async Task LoadAllEvents()
    {
        _eventSearch = string.Empty;
        await FetchEvents();
    }

    private async Task OnEventSearchKeyDown(KeyboardEventArgs args)
    {
        if (_searching) return;
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await SearchEvents();
        }
    }

    private async Task FetchEvents(string? name = null)
    {
        _searching = true;
        _searchCompleted = false;
        _searchResults.Clear();
        StateHasChanged();

        try
        {
            var baseUri = "events/search?pageNumber=1&pageSize=50";
            var requestUri = string.IsNullOrWhiteSpace(name)
                ? baseUri
                : $"{baseUri}&name={Uri.EscapeDataString(name)}";

            var response = await Api.GetFromJsonAsync<JsonElement>(requestUri);

            if (response.TryGetProperty("data", out var items))
            {
                foreach (var item in items.EnumerateArray())
                {
                    _searchResults.Add(new EventResult
                    {
                        Id = item.TryGetProperty("id", out var id) ? id.GetGuid() : Guid.Empty,
                        Name = item.TryGetProperty("eventName", out var eventName) ? eventName.GetString() ?? "" : "",
                        Date = item.TryGetProperty("startDate", out var date) ? date.GetDateTime() : null,
                        Club = item.TryGetProperty("organizationName", out var org) ? org.GetString() ?? "" : "",
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Event search failed: {ex.Message}", Severity.Error);
        }

        _searching = false;
        _searchCompleted = true;
    }

    private async Task SelectEvent(EventResult eventResult)
    {
        _selectedEvent = eventResult;
        _eventLoaded = true;
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        _loadingMembers = true;
        StateHasChanged();

        try
        {
            var response = await Api.GetFromJsonAsync<GradingMembersApiResponse>(
                "grading/members?page=1&pageSize=500");

            if (response is not null)
            {
                var eventDate = _selectedEvent?.Date ?? DateTime.Today;
                _eventCredential = DetectEventCredential(response.Members, _selectedEvent?.Name);
                _totalMemberCount = response.TotalCount;
                _members = response.Members.Select(m => new GradingMember
                {
                    JustGoMemberId = m.JustGoMemberId,
                    MemberId = m.MemberId,
                    FirstName = m.FirstName,
                    LastName = m.LastName,
                    LastGradingDate = m.LastGradingDate is { } d ? d.ToDateTime(TimeOnly.MinValue) : null,
                    CurrentGrade = m.CurrentGrade ?? "Ungraded",
                    NextGrade = m.NextGrade ?? "10th Gup",
                    NextGradeDefinitionId = m.NextGradeDefinitionId,
                    DoubleGrade = m.DoubleGrade,
                    DoubleGradeDefinitionId = m.DoubleGradeDefinitionId,
                    GradingEventDate = eventDate,
                    MatchesEventCredential = MatchesEventCredentialForMember(m, _eventCredential),
                }).ToList();

                foreach (var member in _members.Where(m => m.MatchesEventCredential && !m.IsWithin90Days))
                {
                    member.Grading = true;
                    member.TheoryMark ??= 0;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load members: {ex.Message}", Severity.Error);
        }

        _loadingMembers = false;
        StateHasChanged();
    }

    private void ClearEvent()
    {
        _eventLoaded = false;
        _selectedEvent = null;
        _members.Clear();
        _searchResults.Clear();
        _searchCompleted = false;
        _eventCredential = null;
        _totalMemberCount = 0;
    }

    private async Task OpenAddMembersDialog()
    {
        if (_selectedEvent is null) return;

        var candidates = _members
            .Where(m => m.MatchesEventCredential && !m.Grading)
            .Select(m => new GradingMemberCandidate
            {
                JustGoMemberId = m.JustGoMemberId,
                MemberId = m.MemberId,
                FirstName = m.FirstName,
                LastName = m.LastName,
                LastGradingDate = m.LastGradingDate,
                CurrentGrade = m.CurrentGrade,
                NextGrade = m.NextGrade,
                IsWithin90Days = m.IsWithin90Days,
            })
            .ToList();

        if (candidates.Count == 0)
        {
            Snackbar.Add("No additional members available for this event credential.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Candidates"] = candidates,
            ["CredentialLabel"] = _eventCredential,
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
        };

        var dialog = await DialogService.ShowAsync<AddMembersToGradingDialog>("Add Members to Grading", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<Guid> selectedMemberIds) return;

        foreach (var id in selectedMemberIds)
        {
            var member = _members.FirstOrDefault(m => m.JustGoMemberId == id);
            if (member is null || member.IsWithin90Days) continue;
            member.Grading = true;
            member.TheoryMark ??= 0;
        }
    }

    private void RemoveFromGrading(GradingMember member)
    {
        member.Grading = false;
        member.IsDoubleGrading = false;
        member.TheoryMark = null;
    }

    private static string? DetectEventCredential(IEnumerable<GradingMemberApiDto> members, string? eventName)
    {
        if (string.IsNullOrWhiteSpace(eventName)) return null;

        var possibleCredentials = members
            .SelectMany(m => new[] { m.NextGrade, m.DoubleGrade })
            .Where(grade => !string.IsNullOrWhiteSpace(grade))
            .Select(grade => grade!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(grade => grade.Length)
            .ToList();

        return possibleCredentials
            .FirstOrDefault(grade => eventName.Contains(grade, StringComparison.OrdinalIgnoreCase));
    }

    private static bool MatchesEventCredentialForMember(GradingMemberApiDto member, string? eventCredential)
    {
        if (string.IsNullOrWhiteSpace(eventCredential)) return false;

        return string.Equals(member.NextGrade, eventCredential, StringComparison.OrdinalIgnoreCase) ||
               string.Equals(member.DoubleGrade, eventCredential, StringComparison.OrdinalIgnoreCase);
    }

    private async Task SubmitGrading()
    {
        var gradingMembers = _members.Where(m => m.Grading).ToList();
        if (gradingMembers.Count == 0) return;

        _submitting = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                EventId = _selectedEvent?.Id,
                EventName = _selectedEvent?.Name ?? "",
                EventDate = _selectedEvent?.Date?.ToString("yyyy-MM-dd") ?? DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd"),
                Results = gradingMembers.Select(m => new
                {
                    MemberId = m.JustGoMemberId,
                    CredentialDefinitionId = m.IsDoubleGrading && m.DoubleGradeDefinitionId.HasValue
                        ? m.DoubleGradeDefinitionId.Value
                        : m.NextGradeDefinitionId ?? Guid.Empty,
                    GradeName = m.IsDoubleGrading ? m.DoubleGrade ?? m.NextGrade : m.NextGrade,
                    TheoryMark = m.TheoryMark,
                    IsDoubleGrading = m.IsDoubleGrading,
                }).ToList(),
            };

            var response = await Api.PostAsJsonAsync("grading/submit", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();
                var succeeded = result.TryGetProperty("succeeded", out var s) ? s.GetInt32() : 0;
                var failed = result.TryGetProperty("failed", out var f) ? f.GetInt32() : 0;

                if (failed == 0)
                    Snackbar.Add($"Successfully issued {succeeded} credential(s)!", Severity.Success);
                else
                    Snackbar.Add($"{succeeded} succeeded, {failed} failed. Check details.", Severity.Warning);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Submit failed: {response.StatusCode} — {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submit error: {ex.Message}", Severity.Error);
        }

        _submitting = false;
    }

    // API response DTOs
    private sealed class GradingMembersApiResponse
    {
        public List<GradingMemberApiDto> Members { get; set; } = [];
        public int TotalCount { get; set; }
    }

    private sealed class GradingMemberApiDto
    {
        public Guid JustGoMemberId { get; set; }
        public string MemberId { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? CurrentGrade { get; set; }
        public DateOnly? LastGradingDate { get; set; }
        public string? NextGrade { get; set; }
        public Guid? NextGradeDefinitionId { get; set; }
        public string? DoubleGrade { get; set; }
        public Guid? DoubleGradeDefinitionId { get; set; }
    }

    public class EventResult
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public DateTime? Date { get; set; }
        public string Club { get; set; } = string.Empty;
    }

    public class GradingMember
    {
        public Guid JustGoMemberId { get; set; }
        public string MemberId { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public DateTime? LastGradingDate { get; set; }
        public string CurrentGrade { get; set; } = string.Empty;
        public string NextGrade { get; set; } = string.Empty;
        public Guid? NextGradeDefinitionId { get; set; }
        public string? DoubleGrade { get; set; }
        public Guid? DoubleGradeDefinitionId { get; set; }
        public bool Grading { get; set; }
        public bool IsDoubleGrading { get; set; }
        public int? TheoryMark { get; set; }
        public DateTime GradingEventDate { get; set; }
        public bool MatchesEventCredential { get; set; }

        public bool IsWithin90Days =>
            LastGradingDate.HasValue &&
            (GradingEventDate - LastGradingDate.Value).TotalDays < 90;
    }
}

@page "/grading"
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Grading Entry - ITKD</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudText Typo="Typo.h4" GutterBottom="true">Grading Entry</MudText>

    @if (!_eventLoaded)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">Event Lookup</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_eventSearch" Label="Event Number or Name"
                                  Variant="Variant.Outlined" Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="e.g. EV102452" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SearchEvents" Disabled="_searching"
                               StartIcon="@Icons.Material.Filled.Search">
                        @if (_searching)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Search
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_searchResults.Count > 0)
            {
                <MudTable Items="_searchResults" Hover="true" Striped="true" Class="mt-4"
                          T="EventResult" OnRowClick="@(args => SelectEvent(args.Item!))">
                    <HeaderContent>
                        <MudTh>Event Name</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh>Club</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Date?.ToString("dd MMM yyyy")</MudTd>
                        <MudTd>@context.Club</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (_searchCompleted)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">No events found.</MudAlert>
            }
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Event</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Grading Date</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Date?.ToString("dd MMM yyyy")</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Club</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Club</MudText>
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearEvent"
                       StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-2">
                Change Event
            </MudButton>
        </MudPaper>

        @if (_loadingMembers)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            <MudText>Loading members...</MudText>
        }
        else
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.h6">
                            Members
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                @_totalMemberCount total
                            </MudChip>
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_memberSearch" Label="Search members"
                                      Variant="Variant.Outlined" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Placeholder="Name..." Immediate="true"
                                      DebounceInterval="400"
                                      OnDebounceIntervalElapsed="OnMemberSearchChanged" />
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            Number Grading: @_members.Count(m => m.Grading)
                        </MudText>
                    </MudItem>
                </MudGrid>

                <MudTable Items="_members" Hover="true" Striped="true" Dense="true" Class="mt-4"
                          T="GradingMember" FixedHeader="true" Height="500px">
                    <HeaderContent>
                        <MudTh>MID</MudTh>
                        <MudTh>First Name</MudTh>
                        <MudTh>Last Name</MudTh>
                        <MudTh>Last Grading</MudTh>
                        <MudTh>Current Grade</MudTh>
                        <MudTh>Next Grade</MudTh>
                        <MudTh>Grading</MudTh>
                        <MudTh>Double</MudTh>
                        <MudTh>Theory Mark</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.MemberId</MudTd>
                        <MudTd>@context.FirstName</MudTd>
                        <MudTd>@context.LastName</MudTd>
                        <MudTd>
                            <MudText Color="@(context.IsWithin90Days ? Color.Error : Color.Default)">
                                @context.LastGradingDate?.ToString("dd-MM-yyyy")
                                @if (context.IsWithin90Days)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small"
                                             Color="Color.Error" Title="Within 90 days of last grading" />
                                }
                            </MudText>
                        </MudTd>
                        <MudTd>@context.CurrentGrade</MudTd>
                        <MudTd>@context.NextGrade</MudTd>
                        <MudTd>
                            <MudCheckBox @bind-Value="context.Grading" Color="Color.Primary"
                                         Disabled="context.IsWithin90Days" />
                        </MudTd>
                        <MudTd>
                            <MudCheckBox @bind-Value="context.IsDoubleGrading" Color="Color.Secondary"
                                         Disabled="!context.Grading" />
                        </MudTd>
                        <MudTd>
                            <MudNumericField @bind-Value="context.TheoryMark" Min="0" Max="100"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Style="max-width: 80px;"
                                             Disabled="!context.Grading" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" Class="d-flex justify-end gap-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(!_members.Any(m => m.Grading) || _submitting)"
                               OnClick="SubmitGrading"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               Size="Size.Large">
                        @if (_submitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Issue Credentials
                    </MudButton>
                </MudItem>
            </MudGrid>
        }
    }
</MudContainer>

@code {
    private string _eventSearch = string.Empty;
    private string _memberSearch = string.Empty;
    private bool _searching;
    private bool _searchCompleted;
    private bool _eventLoaded;
    private bool _loadingMembers;
    private bool _submitting;
    private int _totalMemberCount;
    private EventResult? _selectedEvent;
    private List<EventResult> _searchResults = [];
    private List<GradingMember> _members = [];

    private HttpClient Api => HttpClientFactory.CreateClient("JustGoApi");

    private async Task SearchEvents()
    {
        _searching = true;
        _searchCompleted = false;
        _searchResults.Clear();
        StateHasChanged();

        try
        {
            var response = await Api.GetFromJsonAsync<JsonElement>(
                $"events/search?name={Uri.EscapeDataString(_eventSearch)}&pageNumber=1&pageSize=20");

            if (response.TryGetProperty("data", out var items))
            {
                foreach (var item in items.EnumerateArray())
                {
                    _searchResults.Add(new EventResult
                    {
                        Id = item.TryGetProperty("id", out var id) ? id.GetGuid() : Guid.Empty,
                        Name = item.TryGetProperty("eventName", out var name) ? name.GetString() ?? "" : "",
                        Date = item.TryGetProperty("startDate", out var date) ? date.GetDateTime() : null,
                        Club = item.TryGetProperty("organizationName", out var org) ? org.GetString() ?? "" : "",
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Event search failed: {ex.Message}", Severity.Error);
        }

        _searching = false;
        _searchCompleted = true;
    }

    private async Task SelectEvent(EventResult eventResult)
    {
        _selectedEvent = eventResult;
        _eventLoaded = true;
        _memberSearch = string.Empty;
        await LoadMembers();
    }

    private async Task OnMemberSearchChanged(string _)
    {
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        _loadingMembers = true;
        StateHasChanged();

        try
        {
            var searchParam = string.IsNullOrWhiteSpace(_memberSearch) ? "" : $"&search={Uri.EscapeDataString(_memberSearch)}";
            var response = await Api.GetFromJsonAsync<GradingMembersApiResponse>(
                $"grading/members?page=1&pageSize=200{searchParam}");

            if (response is not null)
            {
                var eventDate = _selectedEvent?.Date ?? DateTime.Today;
                _totalMemberCount = response.TotalCount;
                _members = response.Members.Select(m => new GradingMember
                {
                    JustGoMemberId = m.JustGoMemberId,
                    MemberId = m.MemberId,
                    FirstName = m.FirstName,
                    LastName = m.LastName,
                    LastGradingDate = m.LastGradingDate is { } d ? d.ToDateTime(TimeOnly.MinValue) : null,
                    CurrentGrade = m.CurrentGrade ?? "Ungraded",
                    NextGrade = m.NextGrade ?? "10th Gup",
                    NextGradeDefinitionId = m.NextGradeDefinitionId,
                    DoubleGrade = m.DoubleGrade,
                    DoubleGradeDefinitionId = m.DoubleGradeDefinitionId,
                    GradingEventDate = eventDate,
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load members: {ex.Message}", Severity.Error);
        }

        _loadingMembers = false;
        StateHasChanged();
    }

    private void ClearEvent()
    {
        _eventLoaded = false;
        _selectedEvent = null;
        _members.Clear();
        _searchResults.Clear();
        _searchCompleted = false;
        _memberSearch = string.Empty;
        _totalMemberCount = 0;
    }

    private async Task SubmitGrading()
    {
        var gradingMembers = _members.Where(m => m.Grading).ToList();
        if (gradingMembers.Count == 0) return;

        _submitting = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                EventId = _selectedEvent?.Id,
                EventName = _selectedEvent?.Name ?? "",
                EventDate = _selectedEvent?.Date?.ToString("yyyy-MM-dd") ?? DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd"),
                Results = gradingMembers.Select(m => new
                {
                    MemberId = m.JustGoMemberId,
                    CredentialDefinitionId = m.IsDoubleGrading && m.DoubleGradeDefinitionId.HasValue
                        ? m.DoubleGradeDefinitionId.Value
                        : m.NextGradeDefinitionId ?? Guid.Empty,
                    GradeName = m.IsDoubleGrading ? m.DoubleGrade ?? m.NextGrade : m.NextGrade,
                    TheoryMark = m.TheoryMark,
                    IsDoubleGrading = m.IsDoubleGrading,
                }).ToList(),
            };

            var response = await Api.PostAsJsonAsync("grading/submit", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();
                var succeeded = result.TryGetProperty("succeeded", out var s) ? s.GetInt32() : 0;
                var failed = result.TryGetProperty("failed", out var f) ? f.GetInt32() : 0;

                if (failed == 0)
                    Snackbar.Add($"Successfully issued {succeeded} credential(s)!", Severity.Success);
                else
                    Snackbar.Add($"{succeeded} succeeded, {failed} failed. Check details.", Severity.Warning);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Submit failed: {response.StatusCode} — {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submit error: {ex.Message}", Severity.Error);
        }

        _submitting = false;
    }

    // API response DTOs
    private sealed class GradingMembersApiResponse
    {
        public List<GradingMemberApiDto> Members { get; set; } = [];
        public int TotalCount { get; set; }
    }

    private sealed class GradingMemberApiDto
    {
        public Guid JustGoMemberId { get; set; }
        public string MemberId { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? CurrentGrade { get; set; }
        public DateOnly? LastGradingDate { get; set; }
        public string? NextGrade { get; set; }
        public Guid? NextGradeDefinitionId { get; set; }
        public string? DoubleGrade { get; set; }
        public Guid? DoubleGradeDefinitionId { get; set; }
    }

    public class EventResult
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public DateTime? Date { get; set; }
        public string Club { get; set; } = string.Empty;
    }

    public class GradingMember
    {
        public Guid JustGoMemberId { get; set; }
        public string MemberId { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public DateTime? LastGradingDate { get; set; }
        public string CurrentGrade { get; set; } = string.Empty;
        public string NextGrade { get; set; } = string.Empty;
        public Guid? NextGradeDefinitionId { get; set; }
        public string? DoubleGrade { get; set; }
        public Guid? DoubleGradeDefinitionId { get; set; }
        public bool Grading { get; set; }
        public bool IsDoubleGrading { get; set; }
        public int? TheoryMark { get; set; }
        public DateTime GradingEventDate { get; set; }

        public bool IsWithin90Days =>
            LastGradingDate.HasValue &&
            (GradingEventDate - LastGradingDate.Value).TotalDays < 90;
    }
}

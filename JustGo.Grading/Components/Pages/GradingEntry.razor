@page "/grading"
@using JustGo.Grading.Models
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ILogger<GradingEntry> Logger

<PageTitle>Grading Entry - ITKD</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudText Typo="Typo.h4" GutterBottom="true">Grading Entry</MudText>

    @if (!_eventLoaded)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">Event Lookup</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_eventSearch" Label="Event Number or Name"
                                  Variant="Variant.Outlined" Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Placeholder="e.g. EV102452"
                                  Immediate="true"
                                  OnKeyDown="OnEventSearchKeyDown" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SearchEvents" Disabled="_searching"
                               StartIcon="@Icons.Material.Filled.Search">
                        @if (_searching)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Search
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary"
                               OnClick="LoadAllEvents" Disabled="_searching"
                               StartIcon="@Icons.Material.Filled.ViewList"
                               Class="ml-2">
                        Show All
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_searching)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
            }

            @if (_searchResults.Count > 0)
            {
                <MudTable Items="_searchResults" Hover="true" Striped="true" Class="mt-4"
                          T="EventResult" OnRowClick="@(args => SelectEvent(args.Item!))">
                    <HeaderContent>
                        <MudTh>Event Name</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh>Club</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Date?.ToString("dd MMM yyyy")</MudTd>
                        <MudTd>@context.Club</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (_searchCompleted)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">No events found.</MudAlert>
            }
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Event</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Grading Date</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Date?.ToString("dd MMM yyyy")</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Club</MudText>
                    <MudText Typo="Typo.body1">@_selectedEvent!.Club</MudText>
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearEvent"
                       StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-2">
                Change Event
            </MudButton>
        </MudPaper>

        @if (_loadingMembers)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            <MudText>Loading members...</MudText>
        }
        else
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" Class="d-flex justify-start align-center">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="OpenAddMembersDialog"
                                   Disabled="@(_loadingMembers || _submitting)"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">
                            Add Members to Grading
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.h6">
                            Members in Grading
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                @ActiveGradingMembers.Count() selected
                            </MudChip>
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex justify-end align-center">
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            Total Loaded: @_totalMemberCount
                        </MudText>
                    </MudItem>
                </MudGrid>

                <MudTable Items="ActiveGradingMembers" Hover="true" Striped="true" Dense="true" Class="mt-4"
                          T="GradingMember" FixedHeader="true" Height="500px">
                    <HeaderContent>
                        <MudTh>MID</MudTh>
                        <MudTh>First Name</MudTh>
                        <MudTh>Last Name</MudTh>
                        <MudTh>Last Grading</MudTh>
                        <MudTh>Current Grade</MudTh>
                        <MudTh>Next Grade</MudTh>
                        <MudTh>Double</MudTh>
                        <MudTh>Theory Mark</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.MemberId</MudTd>
                        <MudTd>@context.FirstName</MudTd>
                        <MudTd>@context.LastName</MudTd>
                        <MudTd>
                            <MudText Color="@(context.IsWithin90Days ? Color.Error : Color.Default)">
                                @context.LastGradingDate?.ToString("dd-MM-yyyy")
                                @if (context.IsWithin90Days)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small"
                                             Color="Color.Error" Title="Within 90 days of last grading" />
                                }
                            </MudText>
                        </MudTd>
                        <MudTd>@context.CurrentGrade</MudTd>
                        <MudTd>@context.NextGrade</MudTd>
                        <MudTd>
                            <MudCheckBox @bind-Value="context.IsDoubleGrading" Color="Color.Secondary"
                                         Disabled="context.IsWithin90Days" />
                        </MudTd>
                        <MudTd>
                            <MudNumericField @bind-Value="context.TheoryMark" Min="0" Max="100"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Style="max-width: 80px;" />
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Text" Color="Color.Error"
                                       OnClick="@(() => RemoveFromGrading(context))"
                                       StartIcon="@Icons.Material.Filled.RemoveCircleOutline">
                                Remove
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            @if (_eventCandidates.Count > 0)
            {
                <MudPaper Class="pa-4 mb-4" Elevation="2">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.h6">
                                Event Bookings
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                    @_eventCandidates.Count
                                </MudChip>
                            </MudText>
                        </MudItem>
                    </MudGrid>

                    <MudTable Items="_eventCandidates" Hover="true" Striped="true" Dense="true" Class="mt-4"
                              T="EventCandidateApiDto">
                        <HeaderContent>
                            <MudTh>MID</MudTh>
                            <MudTh>First Name</MudTh>
                            <MudTh>Last Name</MudTh>
                            <MudTh>Grade</MudTh>
                            <MudTh>Booking Date</MudTh>
                            <MudTh>Credential</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.MemberNumber</MudTd>
                            <MudTd>@context.FirstName</MudTd>
                            <MudTd>@context.LastName</MudTd>
                            <MudTd>@context.GradeName</MudTd>
                            <MudTd>@context.BookingDate?.LocalDateTime.ToString("dd MMM yyyy")</MudTd>
                            <MudTd>
                                @if (context.HasIssuedCredential)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Issued</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">Booked</MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }

            <MudGrid>
                <MudItem xs="12" Class="d-flex justify-end gap-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(!ActiveGradingMembers.Any() || _submitting)"
                               OnClick="SubmitGrading"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               Size="Size.Large">
                        @if (_submitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Issue Credentials
                    </MudButton>
                </MudItem>
            </MudGrid>
        }
    }
</MudContainer>

@code {
    private string _eventSearch = string.Empty;
    private bool _searching;
    private bool _searchCompleted;
    private bool _eventLoaded;
    private bool _loadingMembers;
    private bool _submitting;
    private int _totalMemberCount;
    private EventResult? _selectedEvent;
    private List<EventResult> _searchResults = [];
    private List<GradingMember> _members = [];
    private List<EventTicketApiDto> _eventTickets = [];
    private List<EventCandidateApiDto> _eventCandidates = [];

    private IEnumerable<GradingMember> ActiveGradingMembers => _members.Where(m => m.Grading);

    private HttpClient Api => HttpClientFactory.CreateClient("JustGoApi");

    protected override async Task OnInitializedAsync()
    {
        await FetchEvents();
    }

    private async Task SearchEvents()
    {
        await FetchEvents(_eventSearch);
    }

    private async Task LoadAllEvents()
    {
        _eventSearch = string.Empty;
        await FetchEvents();
    }

    private async Task OnEventSearchKeyDown(KeyboardEventArgs args)
    {
        if (_searching) return;
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await SearchEvents();
        }
    }

    private async Task FetchEvents(string? name = null)
    {
        _searching = true;
        _searchCompleted = false;
        _searchResults.Clear();
        StateHasChanged();

        try
        {
            var baseUri = "grading/events?pageNumber=1&pageSize=200";
            var requestUri = string.IsNullOrWhiteSpace(name)
                ? baseUri
                : $"{baseUri}&search={Uri.EscapeDataString(name)}";

            var httpResponse = await Api.GetAsync(requestUri);
            if (!httpResponse.IsSuccessStatusCode)
            {
                await ShowApiErrorAsync(httpResponse, "Event search failed");
                return;
            }

            var response = await httpResponse.Content.ReadFromJsonAsync<JsonElement>();

            if (response.TryGetProperty("data", out var items))
            {
                foreach (var item in items.EnumerateArray())
                {
                    _searchResults.Add(new EventResult
                    {
                        Id = TryGetGuid(item, "id"),
                        Name = TryGetString(item, "eventName"),
                        Date = TryGetDateTime(item, "startDate"),
                        Club = TryGetString(item, "organizationName"),
                    });
                }
            }
        }
        catch (Exception ex)
        {
            ShowError("Event search failed", ex);
        }

        _searching = false;
        _searchCompleted = true;
    }

    private static Guid TryGetGuid(JsonElement element, string propertyName)
    {
        if (!element.TryGetProperty(propertyName, out var value) ||
            value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return Guid.Empty;
        }

        return value.ValueKind == JsonValueKind.String &&
               Guid.TryParse(value.GetString(), out var parsedGuid)
            ? parsedGuid
            : value.TryGetGuid(out parsedGuid)
                ? parsedGuid
                : Guid.Empty;
    }

    private static string TryGetString(JsonElement element, string propertyName)
    {
        if (!element.TryGetProperty(propertyName, out var value) ||
            value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return string.Empty;
        }

        return value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : value.ToString();
    }

    private static DateTime? TryGetDateTime(JsonElement element, string propertyName)
    {
        if (!element.TryGetProperty(propertyName, out var value) ||
            value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return null;
        }

        if (value.TryGetDateTime(out var parsedDate))
        {
            return parsedDate;
        }

        return value.ValueKind == JsonValueKind.String &&
               DateTime.TryParse(value.GetString(), out parsedDate)
            ? parsedDate
            : null;
    }

    private async Task SelectEvent(EventResult eventResult)
    {
        _selectedEvent = eventResult;
        _eventLoaded = true;
        _loadingMembers = true;
        StateHasChanged();

        try
        {
            await LoadEventStateAsync();
            RebuildMembersFromCandidates();
        }
        catch (Exception ex)
        {
            ShowError("Failed to load event", ex);
        }
        finally
        {
            _loadingMembers = false;
            StateHasChanged();
        }
    }

    private void RebuildMembersFromCandidates()
    {
        var eventDate = _selectedEvent?.Date ?? DateTime.Today;
        _members = _eventCandidates
            .Where(c => !c.HasIssuedCredential)
            .Select(c => new GradingMember
            {
                JustGoMemberId = c.MemberId,
                MemberId = c.MemberNumber,
                FirstName = c.FirstName,
                LastName = c.LastName,
                LastGradingDate = c.LastGradingDate is { } d ? d.ToDateTime(TimeOnly.MinValue) : null,
                CurrentGrade = c.CurrentGrade ?? "Ungraded",
                NextGrade = c.NextGrade ?? "10th Gup",
                NextGradeDefinitionId = c.NextGradeDefinitionId,
                DoubleGrade = c.DoubleGrade,
                DoubleGradeDefinitionId = c.DoubleGradeDefinitionId,
                GradingEventDate = eventDate,
                BookingId = c.BookingId,
                Grading = true,
                TheoryMark = 0,
                HasIssuedCredential = c.HasIssuedCredential,
            })
            .ToList();

        _totalMemberCount = _eventCandidates.Count;
    }

    private void ShowError(string prefix, Exception ex)
    {
        Logger.LogError(ex, "{Prefix}", prefix);
        Snackbar.Add($"{prefix}: {ex.Message}", Severity.Error);
    }

    private async Task ShowApiErrorAsync(HttpResponseMessage response, string prefix)
    {
        var body = await response.Content.ReadAsStringAsync();
        var message = $"{prefix}: {(int)response.StatusCode} {response.ReasonPhrase}";

        if (!string.IsNullOrWhiteSpace(body))
        {
            try
            {
                using var document = JsonDocument.Parse(body);
                var root = document.RootElement;

                if (root.TryGetProperty("detail", out var detail) &&
                    detail.ValueKind == JsonValueKind.String &&
                    !string.IsNullOrWhiteSpace(detail.GetString()))
                {
                    message = $"{prefix}: {detail.GetString()}";
                }
                else if (root.TryGetProperty("title", out var title) &&
                    title.ValueKind == JsonValueKind.String &&
                    !string.IsNullOrWhiteSpace(title.GetString()))
                {
                    message = $"{prefix}: {title.GetString()}";
                }
            }
            catch (JsonException)
            {
                message = $"{prefix}: {body}";
            }
        }

        Logger.LogError("API error — {Message} (HTTP {StatusCode})", message, (int)response.StatusCode);
        Snackbar.Add(message, Severity.Error);
    }

    private void ClearEvent()
    {
        _eventLoaded = false;
        _loadingMembers = false;
        _selectedEvent = null;
        _members.Clear();
        _searchResults.Clear();
        _searchCompleted = false;
        _totalMemberCount = 0;
        _eventTickets.Clear();
        _eventCandidates.Clear();
    }

    private async Task OpenAddMembersDialog()
    {
        if (_selectedEvent is null) return;

        var existingMemberIds = _members.Select(m => m.JustGoMemberId).ToHashSet();

        var parameters = new DialogParameters
        {
            ["EventId"] = _selectedEvent.Id,
            ["ExistingMemberIds"] = existingMemberIds,
            ["EventTickets"] = _eventTickets,
            ["EventDate"] = _selectedEvent.Date ?? DateTime.Today,
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
        };

        var dialog = await DialogService.ShowAsync<AddMembersToGradingDialog>("Add Members to Grading", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not List<GradingMember> newMembers) return;

        foreach (var member in newMembers)
        {
            if (_members.Any(existing => existing.JustGoMemberId == member.JustGoMemberId))
            {
                continue;
            }

            member.Grading = true;
            member.TheoryMark ??= 0;
            _members.Add(member);
        }

        _totalMemberCount = _members.Count;
    }

    private void RemoveFromGrading(GradingMember member)
    {
        member.Grading = false;
        member.IsDoubleGrading = false;
        member.TheoryMark = null;
    }

    private async Task LoadEventStateAsync()
    {
        if (_selectedEvent?.Id is null || _selectedEvent.Id == Guid.Empty)
        {
            _eventTickets.Clear();
            _eventCandidates.Clear();
            return;
        }

        var httpResponse = await Api.GetAsync($"grading/events/{_selectedEvent.Id}/state");
        if (!httpResponse.IsSuccessStatusCode)
        {
            await ShowApiErrorAsync(httpResponse, "Failed to load event state");
            return;
        }

        var response = await httpResponse.Content.ReadFromJsonAsync<EventStateApiResponse>();
        _eventTickets = response?.Tickets ?? [];
        _eventCandidates = response?.Candidates ?? [];
    }

    private async Task SubmitGrading()
    {
        var gradingMembers = _members.Where(m => m.Grading).ToList();
        if (gradingMembers.Count == 0) return;

        _submitting = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                EventId = _selectedEvent?.Id ?? Guid.Empty,
                EventName = _selectedEvent?.Name ?? "",
                EventDate = _selectedEvent?.Date?.ToString("yyyy-MM-dd") ?? DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd"),
                Results = gradingMembers.Select(m =>
                {
                    var targetDefId = m.IsDoubleGrading && m.DoubleGradeDefinitionId.HasValue
                        ? m.DoubleGradeDefinitionId.Value
                        : m.NextGradeDefinitionId ?? Guid.Empty;
                    var ticket = _eventTickets.FirstOrDefault(t => t.CredentialDefinitionId == targetDefId);

                    return new
                    {
                        MemberId = m.JustGoMemberId,
                        BookingId = m.BookingId,
                        TicketId = ticket?.TicketId ?? Guid.Empty,
                        MemberNumber = m.MemberId,
                        FirstName = m.FirstName,
                        LastName = m.LastName,
                        CredentialDefinitionId = targetDefId,
                        GradeName = m.IsDoubleGrading ? m.DoubleGrade ?? m.NextGrade : m.NextGrade,
                        TheoryMark = m.TheoryMark,
                        IsDoubleGrading = m.IsDoubleGrading,
                    };
                }).ToList(),
            };

            var response = await Api.PostAsJsonAsync("grading/submit", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();
                var succeeded = result.TryGetProperty("succeeded", out var s) ? s.GetInt32() : 0;
                var failed = result.TryGetProperty("failed", out var f) ? f.GetInt32() : 0;

                if (failed == 0)
                {
                    Snackbar.Add($"Successfully issued {succeeded} credential(s)!", Severity.Success);
                }
                else
                {
                    Snackbar.Add($"{succeeded} succeeded, {failed} failed. Check details.", Severity.Warning);
                }

                await LoadEventStateAsync();
                RebuildMembersFromCandidates();
            }
            else
            {
                await ShowApiErrorAsync(response, "Submit failed");
            }
        }
        catch (Exception ex)
        {
            ShowError("Submit error", ex);
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    private sealed class EventStateApiResponse
    {
        public Guid EventId { get; set; }
        public List<EventTicketApiDto> Tickets { get; set; } = [];
        public List<EventCandidateApiDto> Candidates { get; set; } = [];
    }

    private sealed class EventCandidateApiDto
    {
        public Guid BookingId { get; set; }
        public Guid MemberId { get; set; }
        public Guid TicketId { get; set; }
        public string TicketName { get; set; } = string.Empty;
        public string MemberNumber { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? GradeName { get; set; }
        public bool HasIssuedCredential { get; set; }
        public DateTimeOffset? BookingDate { get; set; }
        public string? CurrentGrade { get; set; }
        public Guid? CurrentGradeDefinitionId { get; set; }
        public DateOnly? LastGradingDate { get; set; }
        public string? NextGrade { get; set; }
        public Guid? NextGradeDefinitionId { get; set; }
        public string? DoubleGrade { get; set; }
        public Guid? DoubleGradeDefinitionId { get; set; }
    }

    public class EventResult
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public DateTime? Date { get; set; }
        public string Club { get; set; } = string.Empty;
    }
}

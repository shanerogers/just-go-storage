@using JustGo.Grading.Models
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject ILogger<AddMembersToGradingDialog> Logger

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_searchTerm" Label="Search by name"
                              Variant="Variant.Outlined" Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Placeholder="Last name..."
                              OnKeyDown="OnSearchKeyDown" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="SearchMembers" Disabled="_searching"
                           StartIcon="@Icons.Material.Filled.Search">
                    Search
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_searching)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
        }

        @if (_searchResults.Count > 0)
        {
            <MudTable Items="_searchResults" Hover="true" Striped="true" Dense="true" Class="mt-4"
                      T="SearchResult" FixedHeader="true" Height="420px">
                <HeaderContent>
                    <MudTh></MudTh>
                    <MudTh>MID</MudTh>
                    <MudTh>First Name</MudTh>
                    <MudTh>Last Name</MudTh>
                    <MudTh>Current Grade</MudTh>
                    <MudTh>Next Grade</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudCheckBox T="bool"
                                     Value="@IsSelected(context.JustGoMemberId)"
                                     ValueChanged="@(selected => ToggleSelected(context, selected))"
                                     Disabled="context.AlreadyAttached" />
                    </MudTd>
                    <MudTd>@context.MemberId</MudTd>
                    <MudTd>@context.FirstName</MudTd>
                    <MudTd>@context.LastName</MudTd>
                    <MudTd>@context.CurrentGrade</MudTd>
                    <MudTd>@context.NextGrade</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else if (_searchCompleted)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">No members found. Try a different search term.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="mr-auto">
            Selected: @_selectedMembers.Count
        </MudText>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddSelected"
                   Disabled="@(_selectedMembers.Count == 0)">
            Add Selected
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid EventId { get; set; }
    [Parameter] public HashSet<Guid> ExistingMemberIds { get; set; } = [];
    [Parameter] public List<EventTicketApiDto> EventTickets { get; set; } = [];
    [Parameter] public DateTime EventDate { get; set; }

    private string _searchTerm = string.Empty;
    private bool _searching;
    private bool _searchCompleted;
    private List<SearchResult> _searchResults = [];
    private Dictionary<Guid, GradingMember> _selectedMembers = [];

    private HttpClient Api => HttpClientFactory.CreateClient("JustGoApi");

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (_searching) return;
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await SearchMembers();
        }
    }

    private async Task SearchMembers()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return;

        _searching = true;
        _searchCompleted = false;
        _searchResults.Clear();
        StateHasChanged();

        try
        {
            var httpResponse = await Api.GetAsync(
                $"grading/members?search={Uri.EscapeDataString(_searchTerm.Trim())}&page=1&pageSize=50");
            if (!httpResponse.IsSuccessStatusCode)
            {
                Logger.LogError("Member search failed: {StatusCode}", (int)httpResponse.StatusCode);
                Snackbar.Add("Member search failed", Severity.Error);
            }
            else
            {
                var response = await httpResponse.Content.ReadFromJsonAsync<GradingMembersApiResponse>();
                if (response is not null)
                {
                    _searchResults = response.Members.Select(m => new SearchResult
                    {
                        JustGoMemberId = m.JustGoMemberId,
                        MemberId = m.MemberId,
                        FirstName = m.FirstName,
                        LastName = m.LastName,
                        CurrentGrade = "Loading...",
                        NextGrade = "Loading...",
                        AlreadyAttached = ExistingMemberIds.Contains(m.JustGoMemberId),
                    }).ToList();

                    _searching = false;
                    _searchCompleted = true;
                    StateHasChanged();

                    // Fire-and-forget grade enrichment
                    _ = EnrichSearchResultGradesAsync();
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Member search failed for event {EventId}", EventId);
            Snackbar.Add($"Search error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _searching = false;
            _searchCompleted = true;
        }
    }

    private async Task EnrichSearchResultGradesAsync()
    {
        try
        {
            var memberIds = _searchResults
                .Select(r => r.JustGoMemberId)
                .Where(id => id != Guid.Empty)
                .Distinct()
                .ToList();

            if (memberIds.Count == 0) return;

            var request = new { MemberIds = memberIds };
            var response = await Api.PostAsJsonAsync("grading/members/details", request);

            if (response.IsSuccessStatusCode)
            {
                var details = await response.Content
                    .ReadFromJsonAsync<List<MemberDetailApiResult>>() ?? [];
                var detailById = details.ToDictionary(d => d.MemberId);

                foreach (var result in _searchResults)
                {
                    if (detailById.TryGetValue(result.JustGoMemberId, out var detail))
                    {
                        result.CurrentGrade = detail.CurrentGrade ?? "Ungraded";
                        result.NextGrade = detail.NextGrade ?? "10th Gup";
                        result.NextGradeDefinitionId = detail.NextGradeDefinitionId;
                        result.DoubleGrade = detail.DoubleGrade;
                        result.DoubleGradeDefinitionId = detail.DoubleGradeDefinitionId;
                        result.LastGradingDate = detail.LastGradingDate is { } d
                            ? d.ToDateTime(TimeOnly.MinValue)
                            : null;
                    }
                    else
                    {
                        result.CurrentGrade = "Ungraded";
                        result.NextGrade = "10th Gup";
                    }

                    // Update any already-selected members with enriched data
                    if (_selectedMembers.TryGetValue(result.JustGoMemberId, out var selected))
                    {
                        selected.CurrentGrade = result.CurrentGrade;
                        selected.NextGrade = result.NextGrade;
                        selected.NextGradeDefinitionId = result.NextGradeDefinitionId;
                        selected.DoubleGrade = result.DoubleGrade;
                        selected.DoubleGradeDefinitionId = result.DoubleGradeDefinitionId;
                        selected.LastGradingDate = result.LastGradingDate;
                    }
                }
            }
            else
            {
                foreach (var result in _searchResults.Where(r => r.CurrentGrade == "Loading..."))
                {
                    result.CurrentGrade = "Ungraded";
                    result.NextGrade = "10th Gup";
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Grade enrichment failed");
            foreach (var result in _searchResults.Where(r => r.CurrentGrade == "Loading..."))
            {
                result.CurrentGrade = "Ungraded";
                result.NextGrade = "10th Gup";
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsSelected(Guid memberId) => _selectedMembers.ContainsKey(memberId);

    private void ToggleSelected(SearchResult result, bool selected)
    {
        if (result.AlreadyAttached)
        {
            return;
        }

        if (selected)
        {
            _selectedMembers[result.JustGoMemberId] = new GradingMember
            {
                JustGoMemberId = result.JustGoMemberId,
                MemberId = result.MemberId,
                FirstName = result.FirstName,
                LastName = result.LastName,
                LastGradingDate = result.LastGradingDate,
                CurrentGrade = result.CurrentGrade,
                NextGrade = result.NextGrade,
                NextGradeDefinitionId = result.NextGradeDefinitionId,
                DoubleGrade = result.DoubleGrade,
                DoubleGradeDefinitionId = result.DoubleGradeDefinitionId,
                GradingEventDate = EventDate,
            };
        }
        else
        {
            _selectedMembers.Remove(result.JustGoMemberId);
        }
    }

    private void AddSelected()
    {
        MudDialog.Close(DialogResult.Ok(_selectedMembers.Values.ToList()));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private sealed class GradingMembersApiResponse
    {
        public List<GradingMemberApiDto> Members { get; set; } = [];
        public int TotalCount { get; set; }
    }

    private sealed class GradingMemberApiDto
    {
        public Guid JustGoMemberId { get; set; }
        public string MemberId { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? CurrentGrade { get; set; }
        public DateOnly? LastGradingDate { get; set; }
        public string? NextGrade { get; set; }
        public Guid? NextGradeDefinitionId { get; set; }
        public string? DoubleGrade { get; set; }
        public Guid? DoubleGradeDefinitionId { get; set; }
    }

    private sealed class SearchResult
    {
        public Guid JustGoMemberId { get; set; }
        public string MemberId { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string CurrentGrade { get; set; } = string.Empty;
        public string NextGrade { get; set; } = string.Empty;
        public Guid? NextGradeDefinitionId { get; set; }
        public string? DoubleGrade { get; set; }
        public Guid? DoubleGradeDefinitionId { get; set; }
        public DateTime? LastGradingDate { get; set; }
        public bool AlreadyAttached { get; set; }
    }

    private sealed class MemberDetailApiResult
    {
        public Guid MemberId { get; set; }
        public string? CurrentGrade { get; set; }
        public Guid? CurrentGradeDefinitionId { get; set; }
        public DateOnly? LastGradingDate { get; set; }
        public string? NextGrade { get; set; }
        public Guid? NextGradeDefinitionId { get; set; }
        public string? DoubleGrade { get; set; }
        public Guid? DoubleGradeDefinitionId { get; set; }
    }
}

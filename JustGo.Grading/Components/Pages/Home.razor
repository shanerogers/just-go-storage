@page "/"

<PageTitle>ITKD Grading</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h3" GutterBottom="true">ITKD Gradings</MudText>
    <MudText Typo="Typo.body1" Class="mb-8">
        Manage grading events, view student eligibility, record results, and issue credentials.
    </MudText>

    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudCard Elevation="2" Class="pa-4">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Grading Entry</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText>
                        Look up a grading event, select students, enter theory marks, and issue credentials.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/grading">
                        Start Grading
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@inherits LayoutComponentBase
@inject ILogger<MainLayout> Logger
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">ITKD Gradings</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@ToggleTheme" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="px-4 pb-4">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                        <MudText Typo="Typo.h6">Something went wrong</MudText>
                        <MudText Typo="Typo.body2" Class="mt-2">@ex.Message</MudText>
                    </MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RecoverFromError">
                        Try Again
                    </MudButton>
                </MudContainer>
            </ErrorContent>
        </ErrorBoundary>
    </MudMainContent>
</MudLayout>

@code {
    private ErrorBoundary? _errorBoundary;
    private bool _isDarkMode = true;
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1565C0",
            Secondary = "#FF6F00",
            AppbarBackground = "#1565C0"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#1E88E5",
            Secondary = "#FF6F00",
            AppbarBackground = "#0D47A1",
            Background = "#121212",
            Surface = "#1E1E1E",
            DrawerBackground = "#1A1A1A",
            DrawerText = "rgba(255,255,255,0.7)"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Helvetica", "Arial", "sans-serif"]
            }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // Reset the error boundary on every navigation so the user isn't stuck on the error screen
        _errorBoundary?.Recover();
    }

    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
    }
}
